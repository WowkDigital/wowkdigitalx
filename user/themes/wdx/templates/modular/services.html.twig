<section id="services" data-ruler-label="SERVICES" class="section-pad section"><div class="section-heading"><p class="eyebrow">01 / WHAT I DO</p><h2>{{ page.header.heading|default("COMPLEX CHALLENGES.") }}<br><span class="muted">CLEAR SOLUTIONS.</span></h2><p class="section-intro">Technology, design and a practical approach. Everything your project needs. Nothing it doesn’t.</p></div><div class="services-grid grid md:grid-cols-2 lg:grid-cols-3">{% for item in page.header.items %}<article><span class="number">{{ loop.index < 10 ? "0" : "" }}{{ loop.index }}{{ item.stage is defined ? " / " ~ item.stage : "" }}</span><h3>{{ item.title }}</h3><p>{{ item.text }}</p><span class="service-meta">{{ item.meta }}</span></article>{% endfor %}</div></section>
