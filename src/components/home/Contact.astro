<section id="contact" data-ruler-label="CONTACT" class="section section-pad"><div class="contact-grid grid lg:grid-cols-2 gap-16"><div><p class="eyebrow">05 / GET IN TOUCH</p><h2>YOUR NEXT<br>CHAPTER<br><span class="muted">STARTS HERE.</span></h2><a class="email" href="mailto:kontakt@wowkdigitalx.pl">kontakt@wowkdigitalx.pl</a><p class="muted">Tell me what you have in mind.<br>We’ll work out the next step together.</p></div><form id="contact-form"><div class="grid sm:grid-cols-2 gap-6"><label>Name / Company<input name="name" autocomplete="organization" required placeholder="How should I call you?" maxlength="120"></label><label>Email<input type="email" name="email" autocomplete="email" required placeholder="you@company.com" maxlength="200"></label></div><label>Subject<select name="subject"><option>Website development</option><option>E-commerce</option><option>Automation & integrations</option><option>WordPress</option><option>Custom application</option><option>AI & technology</option><option>Something else</option></select></label><label>Your message<textarea name="message" rows="4" required minlength="10" maxlength="5000" placeholder="A little about your project, goals and timing…"></textarea></label><p class="form-note">This form opens your email app with a prepared draft. Your message is only sent when you send it there.</p><button class="button light" type="submit">PREPARE MESSAGE <span aria-hidden="true">↗</span></button><p id="form-status" role="status"></p></form></div></section>
